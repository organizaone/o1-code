{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "baseUrl": ".",
    "lib": ["ES2023"],
    "composite": true,
    "types": ["node", "vitest/globals"],
    "paths": {
      "@organizaone/o1-code-core": ["../core/src/index.ts"],
      "@organizaone/o1-code-core/subSessionConstants": [
        "../core/src/tools/sub-session-constants.ts"
      ],
      "@organizaone/o1-code-core/transcriptRecords": [
        "../core/src/utils/transcript-records.ts"
      ],
      "@organizaone/o1-code-core/telemetryConstants": [
        "../core/src/telemetry/constants.ts"
      ],
      "@organizaone/o1-code-core/goalWire": ["../core/src/goals/goal-wire.ts"],
      "@organizaone/o1-code-core/noFollowOpen": [
        "../core/src/utils/no-follow-open.ts"
      ],
      "@organizaone/o1-code-core/*": ["../core/src/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"],
  "references": [{ "path": "../core" }]
}
