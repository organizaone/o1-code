{
  "identity": {
    "productName": "o1-code",
    "displayName": "O1-Code",
    "binName": "o1-code",
    "configDir": ".o1-code",
    "contextFile": "AGENTS.md",
    "envPrefix": "O1CODE_",
    "npmName": "@organizaone/o1-code",
    "organization": "OrganizaOne",
    "userAgent": "O1Code",
    "otelServiceName": "o1-code",
    "memorySectionHeader": "## O1-Code Added Memories",
    "repoUrl": "https://github.com/silvioricardo87/o1-code",
    "coAuthorEmail": "o1-code@organizaone.com"
  },
  "lint": {
    "patterns": ["qwen", "alibaba", "dashscope", "gemini[ -]cli\\b"],
    "allow": [
      "Copyright 20[0-9]{2} Qwen",
      "Copyright \\(c\\) 20[0-9]{2} Qwen",
      "Copyright 20[0-9]{2} Alibaba",
      "qwen[0-9]",
      "qwen[- ]?(max|plus|turbo|flash|long|coder|vl|image|omni|asr|mt|math|audio|3)",
      "\\^qwen",
      "startsWith\\('qwen'\\)",
      "qwen\\[",
      "qwen-?\\*",
      "Qwen-MM-Plugins",
      "\\(Qwen, (GLM|DeepSeek)",
      "qwen\\.readthedocs\\.io",
      "dashscope",
      "alibabacloud",
      "alicloudapi\\.com",
      "modelstudio",
      "ModelScope",
      "Alibaba Cloud",
      "alibaba(Standard|-standard|-token-plan|-coding-plan)",
      "'alibaba'",
      "\\(alibaba\\)'",
      "ALIBABA_CLOUD_",
      "ALIBABA_PROVIDERS",
      "alibabaItems",
      "alibaba-select",
      "alibaba-cloud-access-key",
      "Alibaba metadata IP|e\\.g\\. Alibaba 100",
      "Inspired by gemini-cli|Adapted from gemini-cli",
      "Copilot CLI, Claude Code, Gemini CLI"
    ],
    "paths": [
      "packages/**",
      "scripts/**",
      "docs/**",
      "integration-tests/**",
      "integrations/**",
      "*.md",
      "*.js",
      "*.mjs",
      "*.ts",
      "*.json",
      "Makefile",
      "Dockerfile",
      ".github/**"
    ],
    "exclude": [
      "**/LICENSE",
      "LICENSE",
      "**/NOTICES.txt",
      "pnpm-lock.yaml",
      "brand.json",
      "scripts/o1/brand-lint.test.mjs"
    ]
  }
}
