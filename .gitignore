# Secrets and local environment. `.env.example` documents the variables and
# is tracked; every other .env file holds real values.
.env
.env.*
!.env.example
*.pem
*.key
gha-creds-*.json

# Dependencies
node_modules

# Build output and generated sources (regenerated by `prepare`, build, bundle)
dist
*.tsbuildinfo
packages/cli/src/generated/
packages/core/src/generated/
packages/web-templates/src/generated/
packages/audio-capture/build/
packages/audio-capture/prebuilds/
packages/vscode-ide-companion/*.vsix
*.tgz

# Test output
junit.xml
coverage/
packages/*/coverage/
packages/web-shell/client/e2e/playwright-report/
packages/web-shell/client/e2e/test-results/
packages/web-shell/client/e2e/visuals/output/
packages/web-shell/client/e2e/visuals/.playwright/
integration-tests/concurrent-runner/output/
integration-tests/concurrent-runner/task-*
integration-tests/terminal-capture/scenarios/screenshots/
.integration-tests/
# Test-built worker artifact (fzfWorkerHandle.test.ts builds this on the fly)
packages/core/src/utils/filesearch/fzfWorker.js

# Logs and caches
logs/
*.log
tmp/
.eslintcache
.turbo/
.nx/
__pycache__/
.venv

# Local state of o1-code run inside this checkout (review worktrees, caches,
# project settings), untracked except for team memory, which is shared with
# collaborators THROUGH git (memory.enableTeamMemory).
.o1-code/*
!.o1-code/team-memory/
!.o1-code/team-memory/**
# Developer-local session identifier (auto-generated by o1-code serve).
.o1-code-session
# Dev symlink: qc-helper bundled skill docs (created by scripts/dev.js)
packages/core/src/skills/bundled/qc-helper/docs

# Working papers, never in the repository: specs and plans in progress,
# autonomous-round state, mocks, local runner files (ops/), and the reports
# and ledgers of the coding-agent workflows (.superpowers/).
ops/
.superpowers/
pr_body.md

# Editors and other coding agents' state; the project's own skills for
# them are tracked (a directory excluded whole cannot be re-included, so
# `.claude/*` rather than `.claude`).
.idea
*.iml
.vscode/*.local.json
.cursor
.qoder
.codex
.claude/*
!.claude/skills/
!.claude/skills/**
.worktrees/
.playwright-mcp/
.codegraph
# Tool state written to the repo root when $HOME is unset (e.g. gh CLI)
.local/
*.swp
*~

# OS metadata
.DS_Store
Thumbs.db
desktop.ini

# Dependencies install with pnpm from pnpm-lock.yaml; keep an npm install
# from bringing the retired root lockfile back.
/package-lock.json
