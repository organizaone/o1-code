{
  "name": "o1-code-monorepo",
  "private": true,
  "version": "0.12.1",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000",
  "engines": {
    "node": ">=22.0.0"
  },
  "type": "module",
  "workspaces": [
    "packages/*",
    "integrations/external-context",
    "integrations/external-context-mem0"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/organizaone/o1-code.git"
  },
  "config": {
    "sandboxImageUri": "ghcr.io/organizaone/o1-code:0.12.1"
  },
  "scripts": {
    "start": "node scripts/start.js",
    "dev": "node scripts/dev.js",
    "dev:daemon": "node scripts/daemon-dev.js",
    "debug": "cross-env DEBUG=1 node --inspect-brk scripts/start.js",
    "generate": "node scripts/generate-git-commit-info.js && node scripts/o1/generate-brand.mjs",
    "generate:settings-schema": "node --import tsx/esm scripts/generate-settings-schema.ts",
    "build": "cross-env NODE_OPTIONS=\"--max-old-space-size=4096\" node scripts/build.js",
    "build-and-start": "npm run build && npm run start",
    "build:vscode": "node scripts/build_vscode_companion.js",
    "build:all": "npm run build && npm run build:sandbox && npm run build:vscode",
    "build:packages": "corepack pnpm -r run build",
    "build:sandbox": "node scripts/build_sandbox.js",
    "bundle": "npm run generate && node esbuild.config.js && node scripts/copy_bundle_assets.js",
    "test": "cross-env NODE_OPTIONS=\"--max-old-space-size=3072\" npm run test --workspaces --if-present",
    "test:ci:workspaces": "cross-env NODE_OPTIONS=\"--max-old-space-size=3072\" npm run test:ci --workspaces --if-present --",
    "test:ci": "npm run test:ci:workspaces && npm run test:scripts",
    "test:release": "npm run test:release:workspaces && npm run test:scripts",
    "test:release:workspaces": "cross-env NODE_OPTIONS=\"--max-old-space-size=3072\" npm run test:ci --workspaces --if-present -- --coverage.enabled=false",
    "test:scripts": "vitest run --config ./scripts/tests/vitest.config.ts",
    "test:e2e": "cross-env VERBOSE=true KEEP_OUTPUT=true npm run test:integration:sandbox:none",
    "test:integration:all": "npm run test:integration:sandbox:none && npm run test:integration:sandbox:docker && npm run test:integration:sandbox:podman",
    "test:integration:sandbox:none": "cross-env O1CODE_SANDBOX=false vitest run --root ./integration-tests",
    "test:integration:sandbox:docker": "cross-env O1CODE_SANDBOX=docker npm run build:sandbox && O1CODE_SANDBOX=docker vitest run --root ./integration-tests",
    "test:integration:sandbox:podman": "cross-env O1CODE_SANDBOX=podman vitest run --root ./integration-tests",
    "test:integration:no-ak:sandbox:none": "cross-env O1CODE_SANDBOX=false vitest run --root ./integration-tests --maxWorkers 2 ./fake-openai-server.test.ts ./test-helper.test.ts ./chat-transcript-contract.test.ts ./skill-hooks-invocation-parity.test.ts ./skill-hooks-resume.test.ts ./cli/_prompt-latency-policy.test.ts ./cli/daemon-invocation-context.test.ts ./cli/headless-workflow-skill.test.ts ./cli/list_directory.test.ts ./cli/o1-code-serve-routes.test.ts ./cli/o1-code-serve-streaming.test.ts ./cli/o1-code-serve-standalone-concurrency.test.ts ./sdk-typescript/abort-and-lifecycle.test.ts ./sdk-typescript/permission-control.test.ts ./sdk-typescript/sdk-mcp-server.test.ts ./sdk-typescript/subagents.test.ts ./sdk-typescript/system-control.test.ts ./sdk-typescript/tool-control.test.ts",
    "test:integration:sdk:sandbox:none": "cross-env O1CODE_SANDBOX=false vitest run --root ./integration-tests --maxWorkers 2 sdk-typescript",
    "test:integration:sdk:sandbox:docker": "cross-env O1CODE_SANDBOX=docker npm run build:sandbox && O1CODE_SANDBOX=docker vitest run --root ./integration-tests --maxWorkers 2 sdk-typescript",
    "test:integration:cli:sandbox:none": "cross-env O1CODE_SANDBOX=false vitest run --root ./integration-tests cli",
    "test:integration:cli:sandbox:docker": "cross-env O1CODE_SANDBOX=docker npm run build:sandbox && O1CODE_SANDBOX=docker vitest run --root ./integration-tests cli",
    "test:integration:interactive:sandbox:none": "cross-env O1CODE_SANDBOX=false vitest run --root ./integration-tests interactive",
    "test:integration:interactive:sandbox:docker": "cross-env O1CODE_SANDBOX=docker npm run build:sandbox && O1CODE_SANDBOX=docker vitest run --root ./integration-tests interactive",
    "test:terminal-bench": "cross-env VERBOSE=true KEEP_OUTPUT=true vitest run --config ./vitest.terminal-bench.config.ts --root ./integration-tests",
    "test:terminal-bench:oracle": "cross-env VERBOSE=true KEEP_OUTPUT=true vitest run --config ./vitest.terminal-bench.config.ts --root ./integration-tests -t 'oracle'",
    "test:terminal-bench:o1-code": "cross-env VERBOSE=true KEEP_OUTPUT=true vitest run --config ./vitest.terminal-bench.config.ts --root ./integration-tests -t 'o1-code'",
    "lint": "eslint . --ext .ts,.tsx && eslint integration-tests",
    "lint:fix": "eslint . --fix && eslint integration-tests --fix",
    "lint:ci": "eslint . --ext .ts,.tsx --max-warnings 0 && eslint integration-tests --max-warnings 0",
    "lint:all": "node scripts/lint.js",
    "audit:runtime:critical": "node scripts/audit-runtime-critical.js",
    "format": "prettier --experimental-cli --write .",
    "typecheck": "npm run typecheck --workspaces --if-present && npm run typecheck:integration",
    "typecheck:integration": "tsc -p integration-tests/tsconfig.json --pretty false",
    "check-i18n": "npm run check-i18n --workspace=packages/cli",
    "preflight": "npm run clean && corepack pnpm install --frozen-lockfile && npm run format && npm run lint:ci && npm run build && npm run typecheck && npm run test:ci && npm run check:serve-fast-path-bundle",
    "postinstall": "patch-package",
    "prepare": "node scripts/prepare.js",
    "prepare:package": "node scripts/prepare-package.js",
    "package:standalone": "node scripts/create-standalone-package.js",
    "package:standalone:release": "node scripts/build-standalone-release.js",
    "release:version": "node scripts/version.js",
    "telemetry": "node scripts/telemetry.js",
    "check:lockfile": "node scripts/check-lockfile.js",
    "check:tui-dep-direction": "node scripts/check-tui-dep-direction.mjs",
    "check:core-subpath-exports": "node scripts/check-core-subpath-exports.mjs",
    "check:serve-fast-path-bundle": "node scripts/clean-package-build-artifacts.js && npm run build -- --cli-only && cross-env DEV=true npm run bundle && node scripts/check-serve-fast-path-bundle.js",
    "clean": "node scripts/clean.js",
    "pre-commit": "node scripts/pre-commit.js"
  },
  "overrides": {
    "ansi-regex": "6.2.2",
    "cliui": {
      "wrap-ansi": "7.0.0"
    },
    "baseline-browser-mapping": "^2.9.19",
    "normalize-package-data": "^7.0.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "axios": "^1.19.0",
    "@simple-git/argv-parser": "2.0.1",
    "@modelcontextprotocol/sdk": "1.31.0",
    "@grpc/grpc-js": "1.14.5",
    "proxy-addr": "2.0.8",
    "shell-quote": "1.11.0",
    "undici": "7.29.1",
    "browserslist": "4.28.7",
    "source-map-js": "1.2.2",
    "js-yaml": "4.3.2",
    "brace-expansion@^1.0.0": "1.1.21",
    "brace-expansion@^2.0.0": "2.1.7",
    "brace-expansion@^5.0.0": "5.0.12",
    "react-markdown": "^9.0.0"
  },
  "bin": {
    "o1-code": "scripts/cli-entry.js"
  },
  "files": [
    "dist/",
    "scripts/cli-entry.js",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@organizaone/o1-code": "file:packages/cli",
    "@organizaone/o1-code-acp-bridge": "file:packages/acp-bridge",
    "@organizaone/o1-code-core": "file:packages/core",
    "@organizaone/o1-code-sdk": "file:packages/sdk-typescript",
    "@organizaone/o1-code-web-shell": "file:packages/web-shell",
    "@organizaone/o1-code-web-templates": "file:packages/web-templates",
    "@types/chrome": "^0.1.32",
    "@types/jsdom": "^28.0.3",
    "@types/marked": "^5.0.2",
    "@types/mime-types": "^3.0.1",
    "@types/minimatch": "^5.1.2",
    "@types/node": "20.19.1",
    "@types/proper-lockfile": "^4.1.4",
    "@types/shell-quote": "^1.7.5",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/eslint-plugin": "^1.3.4",
    "@xterm/headless": "^5.5.0",
    "@xterm/xterm": "^6.0.0",
    "cross-env": "^7.0.3",
    "esbuild": "^0.25.0",
    "esbuild-plugin-wasm": "^1.1.0",
    "eslint": "^9.24.0",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-check-file": "^3.3.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-license-header": "^0.8.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "glob": "^10.5.0",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "json": "^11.0.0",
    "lint-staged": "^16.1.6",
    "memfs": "^4.42.0",
    "mnemonist": "^0.40.3",
    "msw": "^2.10.4",
    "npm-run-all": "^4.1.5",
    "patch-package": "^8.0.1",
    "playwright": "1.61.1",
    "prettier": "^3.5.3",
    "react-devtools-core": "^6.1.5",
    "semver": "^7.7.2",
    "sharp": "^0.35.5",
    "strip-ansi": "^7.1.2",
    "tsx": "^4.20.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.4.3",
    "vitest": "^4.1.11",
    "yaml": "^2.8.1",
    "yargs": "^17.7.2",
    "zod": "3.25.76"
  },
  "dependencies": {
    "@testing-library/dom": "^10.4.1",
    "ink": "7.0.3",
    "simple-git": "^4.0.1"
  },
  "optionalDependencies": {
    "@lydell/node-pty": "1.2.0-beta.10",
    "@lydell/node-pty-darwin-arm64": "1.2.0-beta.10",
    "@lydell/node-pty-darwin-x64": "1.2.0-beta.10",
    "@lydell/node-pty-linux-x64": "1.2.0-beta.10",
    "@lydell/node-pty-win32-arm64": "1.2.0-beta.10",
    "@lydell/node-pty-win32-x64": "1.2.0-beta.10"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix --max-warnings 0 --no-warn-ignored"
    ],
    "*.{mjs,cjs,json,md,yml,yaml,css,html}": [
      "prettier --write"
    ]
  }
}
